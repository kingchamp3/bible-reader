{
  "expo": {
    "name": "성경을 읽다",
    "slug": "bible-reader",
    "scheme": "biblereader",
    "version": "1.0.0",
    "description": "여러 성경 본문을 오프라인으로 읽고 검색하며 즐겨찾기하는 성경 앱",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kingchamp3.biblereader",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE",
        "foregroundImage": "./assets/android-icon-foreground-v2.png",
        "backgroundImage": "./assets/android-icon-background-v2.png",
        "monochromeImage": "./assets/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
